{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typesilk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  // a second public hostname would compete with the custom domain in search results
  "workers_dev": false,
  "preview_urls": false,
  // only the API, public profiles and race rooms wake the worker; static files stay free and uncounted
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/u/*", "/race/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typesilk",
      "database_id": "b4806751-a1cb-4330-b67f-200f29d42de7",
      "migrations_dir": "migrations"
    }
  ],
  // one object per race room, holding both players' sockets while they race
  "durable_objects": {
    "bindings": [{ "name": "RACE", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "race-rooms", "new_sqlite_classes": ["RaceRoom"] }],
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_READ", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // the secrets live on the worker: TICKET_SECRET, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_SECRET
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23limoN97HnVMw0wUp",
    "GOOGLE_CLIENT_ID": "1098901554589-ttrt5grdri3upmkhtn2gpgr5va5eq1bp.apps.googleusercontent.com"
  },
  // the last two only exist so that a redirect rule on each zone can send them to the first
  "routes": [
    { "pattern": "typesilk.com", "custom_domain": true },
    { "pattern": "www.typesilk.com", "custom_domain": true },
    { "pattern": "typesilk.johannesgrof.me", "custom_domain": true }
  ]
}
